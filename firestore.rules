rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasAdminRecord() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.email == request.auth.token.email;
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.token.admin == true || hasAdminRecord());
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'id',
          'firstName',
          'lastName',
          'username',
          'gender',
          'dob',
          'mobile',
          'alternativeMobile',
          'email',
          'profileImage',
          'verified',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'id',
          'firstName',
          'lastName',
          'username',
          'gender',
          'dob',
          'mobile',
          'alternativeMobile',
          'email',
          'profileImage',
          'verified',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.verified == request.auth.token.email_verified
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.username is string
        && request.resource.data.gender is string
        && request.resource.data.dob is string
        && request.resource.data.mobile is string
        && request.resource.data.alternativeMobile is string
        && request.resource.data.profileImage is string
        && request.resource.data.verified is bool;
    }

    function validOrder(orderId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'customerName',
          'mobile',
          'items',
          'totalAmount',
          'shippingCharge',
          'address',
          'paymentMethod',
          'status',
          'date'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'userId',
          'customerName',
          'mobile',
          'items',
          'totalAmount',
          'shippingCharge',
          'address',
          'paymentMethod',
          'status',
          'date'
        ])
        && request.resource.data.id == orderId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.mobile is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.shippingCharge is number
        && request.resource.data.shippingCharge >= 0
        && request.resource.data.address is map
        && request.resource.data.paymentMethod == 'COD'
        && request.resource.data.status == 'Pending'
        && request.resource.data.date is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && validUserProfile(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'verified',
              'updatedAt'
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'verified'
            ])
            && request.resource.data.verified == request.auth.token.email_verified
            && request.resource.data.updatedAt == request.time
          )
          || (
            validUserProfile(userId)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
          )
        );

      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'firstName',
            'lastName',
            'mobile',
            'altMobile',
            'email',
            'houseNumber',
            'apartmentName',
            'streetName',
            'area',
            'landmark',
            'city',
            'district',
            'state',
            'country',
            'postalCode',
            'type'
          ])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.mobile is string
          && request.resource.data.email is string
          && request.resource.data.city is string
          && request.resource.data.type in ['Home', 'Office', 'Other'];
        allow delete: if isOwner(userId);
      }

      match /wishlist/{productId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['productId'])
          && request.resource.data.productId == productId;
        allow delete: if isOwner(userId);
      }

      match /cart/{cartId} {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create, update: if isOwner(userId)
          && cartId == 'current'
          && request.resource.data.keys().hasOnly(['items'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100;
        allow delete: if isOwner(userId) && cartId == 'current';
      }
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId);
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.stock is number;
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string;
      allow delete: if isAdmin();
    }

    match /settings/storefront {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'initialized',
          'navbarItems',
          'banners',
          'deliveryCost',
          'updatedAt'
        ])
        && request.resource.data.initialized == true
        && request.resource.data.navbarItems is list
        && request.resource.data.banners is list
        && request.resource.data.deliveryCost is number
        && request.resource.data.deliveryCost >= 0;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && validOrder(orderId);
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'productId',
          'userId',
          'customerName',
          'rating',
          'comment',
          'date'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'productId',
          'userId',
          'customerName',
          'rating',
          'comment',
          'date'
        ])
        && request.resource.data.id == reviewId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.customerName is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.date is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
