interface ProfileImageUploadProps {
  value: string;
  onChange: (url: string) => void;
}

function ProfileImageUpload({ value, onChange }: ProfileImageUploadProps) {
  const [dragActive, setDragActive] = useState(false);
  const [tab, setTab] = useState<"file" | "url">(value && value.startsWith("data:") ? "file" : "url");

  const handleFile = (file: File) => {
    if (file && file.type.startsWith("image/")) {
      const reader = new FileReader();
      reader.onloadend = () => {
        if (typeof reader.result === "string") {
          onChange(reader.result);
        }
      };
      reader.readAsDataURL(file);
    }
  };

  return (
    <div className="bg-gray-50 border border-gray-150 p-2.5 rounded space-y-2 mt-1 mb-1 text-left w-full">
      <div className="flex justify-between items-center bg-transparent">
        <span className="text-[8px] font-mono tracking-wider text-gray-450 uppercase font-bold">AVATAR PICTURE BRANDING</span>
        <div className="flex gap-1.5">
          <button
            type="button"
            onClick={() => setTab("file")}
            className={`px-1.5 py-0.5 text-[8px] font-mono tracking-wider font-bold border transition-all ${
              tab === "file" 
                ? "bg-luxury-green/10 text-luxury-green border-luxury-green" 
                : "text-gray-400 border-transparent hover:text-gray-600"
            }`}
          >
            LOCAL FILE
          </button>
          <button
            type="button"
            onClick={() => setTab("url")}
            className={`px-1.5 py-0.5 text-[8px] font-mono tracking-wider font-bold border transition-all ${
              tab === "url" 
                ? "bg-luxury-green/10 text-luxury-green border-luxury-green" 
                : "text-gray-400 border-transparent hover:text-gray-600"
            }`}
          >
            IMAGE URL
          </button>
        </div>
      </div>

      {tab === "file" ? (
        <div
          onDragOver={(e) => { e.preventDefault(); setDragActive(true); }}
          onDragLeave={() => setDragActive(false)}
          onDrop={(e) => { e.preventDefault(); setDragActive(false); if (e.dataTransfer.files?.[0]) handleFile(e.dataTransfer.files[0]); }}
          className={`border border-dashed p-3 text-center transition-all relative cursor-pointer ${
            dragActive ? "border-luxury-green bg-luxury-green/5" : "border-gray-200 hover:border-gray-300 bg-white"
          }`}
        >
          <input
            type="file"
            accept="image/*"
            onChange={(e) => { if (e.target.files?.[0]) handleFile(e.target.files[0]); }}
            className="absolute inset-0 opacity-0 cursor-pointer z-10"
          />
          {value ? (
            <div className="flex items-center gap-2.5 text-left">
              <img
                src={value}
                alt="Selected avatar preview icon"
                className="w-8 h-8 rounded-full object-cover border border-gray-250"
                referrerPolicy="no-referrer"
              />
              <div className="min-w-0 flex-grow">
                <p className="text-[9.5px] font-mono font-semibold text-emerald-600 leading-none">✓ Avatar Image Added</p>
                <p className="text-[7px] text-gray-400 font-mono truncate mt-0.5">{value.startsWith("data:") ? "Local Raw Image Format" : value}</p>
              </div>
            </div>
          ) : (
            <div className="py-1 flex items-center justify-center gap-2 text-gray-450">
              <Upload className="w-3.5 h-3.5 text-gray-400" />
              <div className="text-left font-mono">
                <p className="text-[8px] font-bold text-gray-600 leading-tight">CHOOSE FILE OR DRAG IT HERE</p>
                <p className="text-[7px] text-gray-400 leading-none">Typical image extensions supported</p>
              </div>
            </div>
          )}
        </div>
      ) : (
        <div className="space-y-1">
          <input
            type="text"
            value={value.startsWith("data:") ? "" : value}
            onChange={(e) => onChange(e.target.value)}
            placeholder="e.g. https://images.unsplash.com/photo-..."
            className="w-full bg-white text-xs border border-gray-150 px-2.5 py-1 outline-none lowercase focus:border-luxury-gold"
          />
          {value && !value.startsWith("data:") && (
            <div className="flex items-center gap-2 text-left bg-white p-1 border border-gray-150">
              <img
                src={value}
                alt="Precompiled avatar preview"
                className="w-7 h-7 rounded-full object-cover border border-gray-200"
                referrerPolicy="no-referrer"
              />
              <p className="text-[7.5px] text-gray-400 font-mono truncate flex-grow leading-none">{value}</p>
            </div>
          )}
        </div>
      )}
    </div>
  );
}

