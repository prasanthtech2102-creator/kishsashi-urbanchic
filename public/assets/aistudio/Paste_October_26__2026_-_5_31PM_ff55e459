interface ImageUploadWidgetProps {
  label: string;
  value: string;
  onChange: (url: string) => void;
}

function ImageUploadWidget({ label, value, onChange }: ImageUploadWidgetProps) {
  const [dragActive, setDragActive] = useState(false);
  const [tab, setTab] = useState<"file" | "url">(value && value.startsWith("data:") ? "file" : "url");

  const handleFile = (file: File) => {
    if (file && file.type.startsWith("image/")) {
      const reader = new FileReader();
      reader.onloadend = () => {
        if (typeof reader.result === "string") {
          onChange(reader.result);
        }
      };
      reader.readAsDataURL(file);
    }
  };

  return (
    <div className="bg-neutral-950/40 p-3.5 border border-neutral-800 rounded space-y-3 mt-1 mb-1">
      <div className="flex justify-between items-center pb-1">
        <span className="text-[10px] font-bold tracking-widest text-[#C5A85C] uppercase">{label}</span>
        <div className="flex gap-1.5">
          <button
            type="button"
            onClick={() => setTab("file")}
            className={`px-2 py-0.5 text-[8px] font-mono tracking-widest font-bold border transition-colors ${
              tab === "file" 
                ? "bg-luxury-gold/20 text-luxury-gold border-luxury-gold" 
                : "text-gray-500 border-transparent hover:text-gray-400"
            }`}
          >
            UPLOAD FILE
          </button>
          <button
            type="button"
            onClick={() => setTab("url")}
            className={`px-2 py-0.5 text-[8px] font-mono tracking-widest font-bold border transition-colors ${
              tab === "url" 
                ? "bg-luxury-gold/20 text-luxury-gold border-luxury-gold" 
                : "text-gray-500 border-transparent hover:text-gray-400"
            }`}
          >
            IMAGE URL
          </button>
        </div>
      </div>

      {tab === "file" ? (
        <div
          onDragOver={(e) => { e.preventDefault(); setDragActive(true); }}
          onDragLeave={() => setDragActive(false)}
          onDrop={(e) => { e.preventDefault(); setDragActive(false); if (e.dataTransfer.files?.[0]) handleFile(e.dataTransfer.files[0]); }}
          className={`border-2 border-dashed rounded p-4 text-center transition-all relative cursor-pointer ${
            dragActive ? "border-[#C5A85C] bg-[#C5A85C]/5" : "border-neutral-800 hover:border-neutral-700 bg-neutral-950"
          }`}
        >
          <input
            type="file"
            accept="image/*"
            onChange={(e) => { if (e.target.files?.[0]) handleFile(e.target.files[0]); }}
            className="absolute inset-0 opacity-0 cursor-pointer z-10"
          />
          {value ? (
            <div className="flex items-center gap-3 text-left">
              <img
                src={value}
                alt="Selected thumbnail preview"
                className="w-10 h-14 object-cover border border-neutral-800"
                referrerPolicy="no-referrer"
              />
              <div className="min-w-0 flex-grow">
                <p className="text-[9px] font-mono font-semibold text-emerald-400">✓ Image Loaded Successfully</p>
                <p className="text-[8px] text-gray-500 font-mono truncate mt-0.5">
                  {value.startsWith("data:") ? "Local Raw Base64 Object" : value}
                </p>
                <span className="text-[8px] text-luxury-gold hover:underline mt-1 inline-block font-mono">
                  Drop another file or click to replace
                </span>
              </div>
            </div>
          ) : (
            <div className="py-2 flex flex-col items-center justify-center gap-1.5">
              <Upload className="w-4 h-4 text-gray-500" />
              <p className="text-[9px] font-semibold text-gray-300">DRAG & DROP LOCAL PRODUCT IMAGE</p>
              <p className="text-[8px] text-gray-500">OR CLICK TO BROWSE COMPUTER</p>
            </div>
          )}
        </div>
      ) : (
        <div className="space-y-2">
          <input
            type="text"
            value={value.startsWith("data:") ? "" : value}
            onChange={(e) => onChange(e.target.value)}
            placeholder="Paste high-res Unsplash image URL address"
            className="w-full bg-neutral-950 border border-neutral-800 px-3 py-2 outline-none focus:border-luxury-gold text-white text-xs uppercase"
          />
          {value && !value.startsWith("data:") && (
            <div className="flex items-center gap-3 text-left bg-neutral-950 p-2 border border-neutral-800">
              <img
                src={value}
                alt="URL preview"
                className="w-10 h-14 object-cover border border-neutral-800"
                referrerPolicy="no-referrer"
              />
              <p className="text-[8px] text-gray-500 font-mono truncate flex-grow leading-tight">{value}</p>
            </div>
          )}
        </div>
      )}
    </div>
  );
}

